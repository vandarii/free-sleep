// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model sleep_records {
  id                    Int      @id @default(autoincrement())
  side                  String
  entered_bed_at        Int
  left_bed_at           Int
  sleep_period_seconds  Int
  times_exited_bed      Int
  present_intervals     String
  not_present_intervals String

  @@unique([side, entered_bed_at])
  // Create an index on 'side' and 'entered_bed_at'
  @@index([side, entered_bed_at])
}

model vitals {
  id             Int    @id @default(autoincrement())
  side           String
  timestamp      Int // 5-minute interval start (Unix timestamp)
  heart_rate     Float? // Averaged over 5 minutes
  hrv            Float? // Averaged over 5 minutes
  breathing_rate Float? // Averaged over 5 minutes

  @@unique([side, timestamp]) // Ensure no duplicate intervals
  @@index([side, timestamp])
}


model movement {
  id              Int      @id @default(autoincrement())
  timestamp       Int
  side            String
  total_movement  Int
  @@unique([side, timestamp]) // Ensure no duplicate intervals
  @@index([side, timestamp])
}



// Autopilot sleep sessions, started and ended manually (button, tap or API)
model sleep_sessions {
  id                 Int     @id @default(autoincrement())
  side               String
  started_at         Int
  ended_at           Int?
  end_reason         String? // manual | tap | api | out_of_bed | max_length
  start_source       String  // manual | tap | api
  is_nap             Boolean @default(false) // nap_requested, or shorter than the nap threshold once ended
  nap_requested      Boolean @default(false) // started with "Start nap"
  wake_at            Int?
  dry_run            Boolean

  @@index([side, started_at])
}

// Every temperature decision Autopilot makes (applied, or logged in dry run)
model autopilot_decisions {
  id          Int     @id @default(autoincrement())
  session_id  Int
  timestamp   Int
  stage       String
  target_f    Int     // stage target before live adjustments
  set_f       Int     // value applied, or that would be applied in dry run
  reason      String  // stage | room | wake | nap
  detail      String?
  dry_run     Boolean

  @@index([session_id, timestamp])
}

// Ambient readings from the hub and cover sensors, averaged into 5-minute buckets
model ambient {
  id            Int    @id @default(autoincrement())
  timestamp     Int    // 5-minute interval start (Unix timestamp)
  hub_amb_c     Float?
  cover_amb_c   Float?
  humidity      Float?
  left_body_c   Float?
  right_body_c  Float?

  @@unique([timestamp])
  @@index([timestamp])
}
